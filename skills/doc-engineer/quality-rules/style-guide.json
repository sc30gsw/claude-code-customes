{
  "formatting": {
    "heading_style": "atx",
    "list_marker_style": "consistent",
    "code_fence_style": "backticks",
    "emphasis_style": "asterisk",
    "link_style": "inline",
    "max_line_length": 120,
    "trailing_whitespace": "remove",
    "final_newline": "required"
  },
  "code_blocks": {
    "require_language_tag": true,
    "supported_languages": [
      "javascript",
      "typescript",
      "python",
      "java",
      "go",
      "rust",
      "c",
      "cpp",
      "csharp",
      "php",
      "ruby",
      "bash",
      "sh",
      "json",
      "yaml",
      "xml",
      "html",
      "css",
      "sql",
      "markdown"
    ],
    "prefer_explicit_language": true,
    "code_fence_marker": "```"
  },
  "terminology": {
    "prefer_american_english": true,
    "technical_terms": {
      "API": "API (not Api or api)",
      "URL": "URL (not Url or url)",
      "HTTP": "HTTP (not Http)",
      "JSON": "JSON (not Json)",
      "XML": "XML (not Xml)",
      "SQL": "SQL (not Sql)",
      "ID": "ID (not Id)",
      "OK": "OK (not Ok or okay)"
    },
    "avoid_abbreviations": [
      "etc",
      "e.g.",
      "i.e."
    ],
    "prefer_full_words": true
  },
  "structure": {
    "heading_capitalization": "title-case",
    "list_punctuation": "consistent",
    "paragraph_spacing": "double-newline",
    "section_spacing": "double-newline",
    "prefer_ordered_lists_for_steps": true,
    "prefer_unordered_lists_for_features": true
  },
  "links": {
    "prefer_descriptive_text": true,
    "avoid_bare_urls": true,
    "check_external_links": true,
    "require_https": true,
    "link_text_patterns": {
      "avoid": ["click here", "here", "this", "link"],
      "prefer": ["descriptive phrases", "action verbs"]
    }
  },
  "images": {
    "require_alt_text": true,
    "prefer_relative_paths": true,
    "supported_formats": ["png", "jpg", "jpeg", "gif", "svg", "webp"],
    "max_width": 1200,
    "naming_convention": "kebab-case"
  },
  "tables": {
    "require_header": true,
    "align_columns": true,
    "prefer_simple_tables": true,
    "max_columns": 6
  },
  "comments": {
    "html_comments_allowed": false,
    "prefer_markdown_notes": true,
    "blockquote_for_notes": true
  },
  "examples": {
    "require_code_examples_for_technical_docs": true,
    "min_examples_per_section": 1,
    "example_format": "code_fence",
    "include_expected_output": true
  },
  "accessibility": {
    "require_heading_hierarchy": true,
    "require_descriptive_link_text": true,
    "require_alt_text_for_images": true,
    "avoid_color_only_indicators": true,
    "prefer_semantic_markup": true
  },
  "best_practices": {
    "one_sentence_per_line": false,
    "max_sentence_length": 25,
    "max_paragraph_length": 150,
    "prefer_active_voice": true,
    "avoid_passive_constructions": true,
    "use_present_tense": true,
    "avoid_future_tense": true,
    "spell_check": true,
    "grammar_check": true
  }
}
